rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function policyPath() {
      return /databases/$(database)/documents/security_settings/owner_policy;
    }

    function isAllowedAccount() {
      return isSignedIn() && (
        !exists(policyPath()) ||
        get(policyPath()).data.ownerUid == request.auth.uid ||
        (request.auth.token.email != null &&
          get(policyPath()).data.allowedEmails is list &&
          request.auth.token.email in get(policyPath()).data.allowedEmails)
      );
    }

    function isOwner(userId) {
      return isAllowedAccount() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function validTimestamps(data) {
      return data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMemoryProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.rawText is string && data.rawText.size() <= 15000 &&
             data.firstName is string && data.firstName.size() <= 80 &&
             data.musicStyle is string && data.musicStyle.size() <= 500 &&
             data.favoriteArtists is string && data.favoriteArtists.size() <= 500 &&
             data.wyattLikes is string && data.wyattLikes.size() <= 1000 &&
             data.wyattWantsToLearn is string && data.wyattWantsToLearn.size() <= 1000 &&
             data.wyattMemories is string && data.wyattMemories.size() <= 2500 &&
             data.shortTermGoals is string && data.shortTermGoals.size() <= 1000 &&
             data.longTermGoals is string && data.longTermGoals.size() <= 1000 &&
             data.decisionsMade is string && data.decisionsMade.size() <= 2500 &&
             data.inProgress is string && data.inProgress.size() <= 2500 &&
             data.tradingLevel is string && data.tradingLevel.size() <= 200 &&
             validTimestamps(data);
    }

    function isValidChatMessage(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.role in ['user', 'hazard'] &&
             data.speakerMode in ['raphael', 'wyatt', 'unknown'] &&
             data.topic is string && data.topic.size() >= 1 && data.topic.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 15000 &&
             data.requiresConfirmation is bool &&
             validTimestamps(data);
    }

    function isValidCreationItem(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.category in ['music', 'promo', 'admin', 'projects', 'trading', 'wyatt'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 15000 &&
             data.tags is list && data.tags.size() <= 8 &&
             (data.tags.size() == 0 || data.tags[0] is string) &&
             data.pinned is bool &&
             validTimestamps(data);
    }

    function isValidWatchlistAsset(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.assetType in ['crypto', 'gold', 'stock'] &&
             data.apiId is string && data.apiId.size() >= 1 && data.apiId.size() <= 80 &&
             validTimestamps(data);
    }

    function isValidPriceAlert(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             data.assetName is string && data.assetName.size() >= 1 && data.assetName.size() <= 80 &&
             data.apiId is string && data.apiId.size() >= 1 && data.apiId.size() <= 80 &&
             data.assetType in ['crypto', 'gold', 'stock'] &&
             data.targetPrice is number && data.targetPrice > 0 &&
             data.above is bool &&
             data.triggered is bool &&
             validTimestamps(data);
    }

    function isValidSimWallet(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.cashEur is number && data.cashEur >= 0 &&
             data.initialEur is number && data.initialEur > 0 &&
             validTimestamps(data);
    }

    function isValidSimPosition(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             data.assetName is string && data.assetName.size() >= 1 && data.assetName.size() <= 80 &&
             data.assetType in ['crypto', 'gold', 'stock'] &&
             data.quantity is number && data.quantity >= 0 &&
             data.avgBuyPrice is number && data.avgBuyPrice >= 0 &&
             validTimestamps(data);
    }

    function isValidSimTrade(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 24 &&
             data.assetName is string && data.assetName.size() >= 1 && data.assetName.size() <= 80 &&
             data.side in ['buy', 'sell'] &&
             data.quantity is number && data.quantity > 0 &&
             data.price is number && data.price > 0 &&
             data.totalEur is number && data.totalEur > 0 &&
             validTimestamps(data);
    }

    function isValidJournalEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.asset is string && data.asset.size() >= 1 && data.asset.size() <= 40 &&
             data.direction in ['long', 'short', 'spot'] &&
             data.entryPrice is string && data.entryPrice.size() <= 40 &&
             data.exitPrice is string && data.exitPrice.size() <= 40 &&
             data.stopLoss is string && data.stopLoss.size() <= 40 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 2000 &&
             data.emotion is string && data.emotion.size() <= 200 &&
             data.outcome is string && data.outcome.size() <= 500 &&
             data.aiFeedback is string && data.aiFeedback.size() <= 6000 &&
             validTimestamps(data);
    }

    function isValidBudgetEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.kind in ['income', 'expense'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
             data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
             data.amountEur is number && data.amountEur > 0 && data.amountEur <= 10000000 &&
             data.monthKey is string && data.monthKey.size() >= 4 && data.monthKey.size() <= 16 &&
             validTimestamps(data);
    }

    function isValidSavingsGoal(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             data.targetEur is number && data.targetEur > 0 &&
             data.savedEur is number && data.savedEur >= 0 &&
             validTimestamps(data);
    }

    function isValidMusicRevenue(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.trackTitle is string && data.trackTitle.size() >= 1 && data.trackTitle.size() <= 120 &&
             data.source in ['streams', 'tiktok', 'sales'] &&
             data.playsCount is number && data.playsCount >= 0 &&
             data.amountEur is number && data.amountEur >= 0 &&
             data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 40 &&
             validTimestamps(data);
    }

    function isValidSaasProject(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             data.problem is string && data.problem.size() <= 1500 &&
             data.audience is string && data.audience.size() <= 1000 &&
             data.competition is string && data.competition.size() <= 1500 &&
             data.pricing is string && data.pricing.size() <= 500 &&
             data.businessPlan is string && data.businessPlan.size() <= 8000 &&
             data.roadmap is string && data.roadmap.size() <= 8000 &&
             data.nextAction is string && data.nextAction.size() <= 500 &&
             data.status in ['idea', 'building', 'launched'] &&
             data.actionDone is bool &&
             validTimestamps(data);
    }

    function isValidBotStrategy(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 100 &&
             data.description is string && data.description.size() >= 1 && data.description.size() <= 1000 &&
             data.assetSymbol is string && data.assetSymbol.size() >= 1 && data.assetSymbol.size() <= 24 &&
             data.apiId is string && data.apiId.size() >= 1 && data.apiId.size() <= 80 &&
             data.buyDropPct is number && data.buyDropPct > 0 && data.buyDropPct <= 95 &&
             data.takeProfitPct is number && data.takeProfitPct > 0 && data.takeProfitPct <= 1000 &&
             data.stopLossPct is number && data.stopLossPct > 0 && data.stopLossPct <= 95 &&
             data.amountPerTradeEur is number && data.amountPerTradeEur > 0 &&
             data.maxTotalLossEur is number && data.maxTotalLossEur > 0 &&
             data.maxTradesCount is number && data.maxTradesCount >= 1 &&
             data.mode in ['simulation', 'real'] &&
             data.status in ['idle', 'running', 'stopped'] &&
             data.tradesExecuted is number && data.tradesExecuted >= 0 &&
             data.winsCount is number && data.winsCount >= 0 &&
             data.lossesCount is number && data.lossesCount >= 0 &&
             data.cumulativePnlEur is number &&
             data.referencePrice is number && data.referencePrice >= 0 &&
             data.lastActionNote is string && data.lastActionNote.size() <= 1000 &&
             validTimestamps(data);
    }

    match /users/{userId}/bot_strategies/{strategyId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(strategyId);
      allow create: if isOwner(userId) && isValidId(strategyId) &&
                       incoming().keys().hasAll([
                         'userId', 'name', 'description', 'assetSymbol', 'apiId',
                         'buyDropPct', 'takeProfitPct', 'stopLossPct',
                         'amountPerTradeEur', 'maxTotalLossEur', 'maxTradesCount',
                         'mode', 'status', 'tradesExecuted', 'winsCount', 'lossesCount',
                         'cumulativePnlEur', 'referencePrice', 'lastActionNote',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'name', 'description', 'assetSymbol', 'apiId',
                         'buyDropPct', 'takeProfitPct', 'stopLossPct',
                         'amountPerTradeEur', 'maxTotalLossEur', 'maxTradesCount',
                         'mode', 'status', 'tradesExecuted', 'winsCount', 'lossesCount',
                         'cumulativePnlEur', 'referencePrice', 'lastActionNote',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidBotStrategy(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(strategyId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBotStrategy(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'mode', 'status', 'tradesExecuted', 'winsCount', 'lossesCount',
                         'cumulativePnlEur', 'referencePrice', 'lastActionNote',
                         'amountPerTradeEur', 'maxTotalLossEur', 'maxTradesCount', 'updatedAt'
                       ]);
    }

    match /users/{userId}/memories/{memoryId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(memoryId);
      allow create: if isOwner(userId) && isValidId(memoryId) &&
                       incoming().keys().hasAll([
                         'userId', 'rawText', 'firstName', 'musicStyle', 'favoriteArtists',
                         'wyattLikes', 'wyattWantsToLearn', 'wyattMemories',
                         'shortTermGoals', 'longTermGoals', 'decisionsMade', 'inProgress',
                         'tradingLevel', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'rawText', 'firstName', 'musicStyle', 'favoriteArtists',
                         'wyattLikes', 'wyattWantsToLearn', 'wyattMemories',
                         'shortTermGoals', 'longTermGoals', 'decisionsMade', 'inProgress',
                         'tradingLevel', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidMemoryProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(memoryId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidMemoryProfile(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'rawText', 'firstName', 'musicStyle', 'favoriteArtists',
                         'wyattLikes', 'wyattWantsToLearn', 'wyattMemories',
                         'shortTermGoals', 'longTermGoals', 'decisionsMade', 'inProgress',
                         'tradingLevel', 'updatedAt'
                       ]);
      allow delete: if isOwner(userId) && isValidId(memoryId);
    }

    match /users/{userId}/messages/{messageId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(messageId);
      allow create: if isOwner(userId) && isValidId(messageId) &&
                       incoming().keys().hasAll([
                         'userId', 'role', 'speakerMode', 'topic', 'text',
                         'requiresConfirmation', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'role', 'speakerMode', 'topic', 'text',
                         'requiresConfirmation', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidChatMessage(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(messageId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().role == existing().role &&
                       isValidChatMessage(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['text', 'requiresConfirmation', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(messageId);
    }

    match /users/{userId}/creations/{creationId} {
      allow list: if isOwner(userId);
      allow get: if isOwner(userId) && isValidId(creationId);
      allow create: if isOwner(userId) && isValidId(creationId) &&
                       incoming().keys().hasAll(['userId', 'category', 'title', 'content', 'tags', 'pinned', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'category', 'title', 'content', 'tags', 'pinned', 'createdAt', 'updatedAt']) &&
                       isValidCreationItem(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(creationId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidCreationItem(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['category', 'title', 'content', 'tags', 'pinned', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(creationId);
    }

    match /users/{userId}/watchlist/{assetId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(assetId);
      allow create: if isOwner(userId) && isValidId(assetId) &&
                       incoming().keys().hasAll(['userId', 'symbol', 'name', 'assetType', 'apiId', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'symbol', 'name', 'assetType', 'apiId', 'createdAt', 'updatedAt']) &&
                       isValidWatchlistAsset(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(assetId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidWatchlistAsset(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
    }

    match /users/{userId}/price_alerts/{alertId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(alertId);
      allow create: if isOwner(userId) && isValidId(alertId) &&
                       incoming().keys().hasAll(['userId', 'symbol', 'assetName', 'apiId', 'assetType', 'targetPrice', 'above', 'triggered', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'symbol', 'assetName', 'apiId', 'assetType', 'targetPrice', 'above', 'triggered', 'createdAt', 'updatedAt']) &&
                       isValidPriceAlert(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(alertId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPriceAlert(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['targetPrice', 'above', 'triggered', 'updatedAt']);
    }

    match /users/{userId}/sim_wallet/{walletId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(walletId);
      allow create: if isOwner(userId) && isValidId(walletId) &&
                       incoming().keys().hasAll(['userId', 'cashEur', 'initialEur', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'cashEur', 'initialEur', 'createdAt', 'updatedAt']) &&
                       isValidSimWallet(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(walletId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSimWallet(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['cashEur', 'initialEur', 'updatedAt']);
    }

    match /users/{userId}/sim_positions/{positionId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(positionId);
      allow create: if isOwner(userId) && isValidId(positionId) &&
                       incoming().keys().hasAll(['userId', 'symbol', 'assetName', 'assetType', 'quantity', 'avgBuyPrice', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'symbol', 'assetName', 'assetType', 'quantity', 'avgBuyPrice', 'createdAt', 'updatedAt']) &&
                       isValidSimPosition(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(positionId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSimPosition(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'avgBuyPrice', 'updatedAt']);
    }

    match /users/{userId}/sim_trades/{tradeId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(tradeId);
      allow create: if isOwner(userId) && isValidId(tradeId) &&
                       incoming().keys().hasAll(['userId', 'symbol', 'assetName', 'side', 'quantity', 'price', 'totalEur', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'symbol', 'assetName', 'side', 'quantity', 'price', 'totalEur', 'createdAt', 'updatedAt']) &&
                       isValidSimTrade(incoming(), userId);
      allow update: if false;
    }

    match /users/{userId}/journal_entries/{entryId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(entryId);
      allow create: if isOwner(userId) && isValidId(entryId) &&
                       incoming().keys().hasAll(['userId', 'asset', 'direction', 'entryPrice', 'exitPrice', 'stopLoss', 'reason', 'emotion', 'outcome', 'aiFeedback', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'asset', 'direction', 'entryPrice', 'exitPrice', 'stopLoss', 'reason', 'emotion', 'outcome', 'aiFeedback', 'createdAt', 'updatedAt']) &&
                       isValidJournalEntry(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(entryId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidJournalEntry(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['outcome', 'aiFeedback', 'exitPrice', 'updatedAt']);
    }

    match /users/{userId}/budget_entries/{entryId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(entryId);
      allow create: if isOwner(userId) && isValidId(entryId) &&
                       incoming().keys().hasAll(['userId', 'kind', 'category', 'label', 'amountEur', 'monthKey', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'kind', 'category', 'label', 'amountEur', 'monthKey', 'createdAt', 'updatedAt']) &&
                       isValidBudgetEntry(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(entryId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidBudgetEntry(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['category', 'label', 'amountEur', 'updatedAt']);
    }

    match /users/{userId}/savings_goals/{goalId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(goalId);
      allow create: if isOwner(userId) && isValidId(goalId) &&
                       incoming().keys().hasAll(['userId', 'title', 'targetEur', 'savedEur', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'title', 'targetEur', 'savedEur', 'createdAt', 'updatedAt']) &&
                       isValidSavingsGoal(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(goalId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSavingsGoal(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['title', 'targetEur', 'savedEur', 'updatedAt']);
    }

    match /users/{userId}/music_revenues/{revId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(revId);
      allow create: if isOwner(userId) && isValidId(revId) &&
                       incoming().keys().hasAll(['userId', 'trackTitle', 'source', 'playsCount', 'amountEur', 'periodLabel', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'trackTitle', 'source', 'playsCount', 'amountEur', 'periodLabel', 'createdAt', 'updatedAt']) &&
                       isValidMusicRevenue(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(revId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidMusicRevenue(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['playsCount', 'amountEur', 'periodLabel', 'updatedAt']);
    }

    match /users/{userId}/saas_projects/{projectId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(projectId);
      allow create: if isOwner(userId) && isValidId(projectId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'problem', 'audience', 'competition', 'pricing',
                         'businessPlan', 'roadmap', 'nextAction', 'status', 'actionDone',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'problem', 'audience', 'competition', 'pricing',
                         'businessPlan', 'roadmap', 'nextAction', 'status', 'actionDone',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidSaasProject(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(projectId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSaasProject(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'title', 'problem', 'audience', 'competition', 'pricing',
                         'businessPlan', 'roadmap', 'nextAction', 'status', 'actionDone', 'updatedAt'
                       ]);
    }

    function isValidOwnerPolicy(data, callerUid) {
      return data.ownerUid is string && data.ownerUid == callerUid &&
             data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 160 &&
             data.wyattEmail is string && data.wyattEmail.size() <= 160 &&
             data.allowedEmails is list && data.allowedEmails.size() >= 1 && data.allowedEmails.size() <= 4 &&
             data.lastLoginEmail is string && data.lastLoginEmail.size() <= 160 &&
             data.lastLoginDevice is string && data.lastLoginDevice.size() <= 120 &&
             data.lastLoginAt is timestamp && data.lastLoginAt <= request.time &&
             validTimestamps(data);
    }

    function isValidSecurityEvent(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.eventType in ['login', 'anomaly', 'protection'] &&
             data.severity in ['info', 'warning', 'critical'] &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.detail is string && data.detail.size() <= 1200 &&
             data.deviceLabel is string && data.deviceLabel.size() <= 120 &&
             data.resolved is bool &&
             validTimestamps(data);
    }

    function isValidImprovementProposal(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.category in ['bug', 'perf', 'security', 'simplify', 'feature', 'ecosystem'] &&
             data.priority in ['haute', 'moyenne'] &&
             data.whatToChange is string && data.whatToChange.size() >= 1 && data.whatToChange.size() <= 2000 &&
             data.why is string && data.why.size() >= 1 && data.why.size() <= 2000 &&
             data.impact is string && data.impact.size() >= 1 && data.impact.size() <= 1500 &&
             data.risks is string && data.risks.size() >= 1 && data.risks.size() <= 1500 &&
             data.rollbackHowTo is string && data.rollbackHowTo.size() >= 1 && data.rollbackHowTo.size() <= 1500 &&
             data.preparedPlan is string && data.preparedPlan.size() <= 6000 &&
             data.weekKey is string && data.weekKey.size() >= 4 && data.weekKey.size() <= 16 &&
             data.status in ['pending', 'applied', 'refused', 'postponed', 'rolled_back'] &&
             data.appliedVersionId is string && data.appliedVersionId.size() <= 128 &&
             data.beforePreview is string && data.beforePreview.size() <= 1000 &&
             data.afterPreview is string && data.afterPreview.size() <= 1000 &&
             data.supports24hTrial is bool &&
             data.trialAccentStyle is string && data.trialAccentStyle.size() <= 40 &&
             data.trialThemeMode is string && data.trialThemeMode.size() <= 20 &&
             validTimestamps(data);
    }

    function isValidUiPreferences(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.themeMode in ['dark', 'light'] &&
             data.accentStyle in ['hazard', 'emerald', 'amber', 'violet', 'ocean'] &&
             data.textScale is number && data.textScale >= 0.8 && data.textScale <= 1.6 &&
             data.moduleOrder is list && data.moduleOrder.size() <= 15 &&
             data.hiddenModules is list && data.hiddenModules.size() <= 15 &&
             data.enabledGadgets is list && data.enabledGadgets.size() <= 10 &&
             data.trialLabel is string && data.trialLabel.size() <= 120 &&
             data.trialExpiresAtMs is number && data.trialExpiresAtMs >= 0 &&
             data.previousThemeSnapshot is string && data.previousThemeSnapshot.size() <= 160 &&
             validTimestamps(data);
    }

    function isValidAppVersionSnapshot(data, userId) {
      return data.userId is string && data.userId == userId &&
             data.versionTag is string && data.versionTag.size() >= 1 && data.versionTag.size() <= 40 &&
             data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 1000 &&
             data.appliedProposalIds is list && data.appliedProposalIds.size() <= 50 &&
             data.activeNotes is string && data.activeNotes.size() <= 4000 &&
             data.current is bool &&
             validTimestamps(data);
    }

    match /security_settings/owner_policy {
      allow list: if false;
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
                       !exists(policyPath()) &&
                       incoming().keys().hasAll([
                         'ownerUid', 'ownerEmail', 'wyattEmail', 'allowedEmails',
                         'lastLoginEmail', 'lastLoginDevice', 'lastLoginAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerUid', 'ownerEmail', 'wyattEmail', 'allowedEmails',
                         'lastLoginEmail', 'lastLoginDevice', 'lastLoginAt',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidOwnerPolicy(incoming(), request.auth.uid);
      allow update: if isSignedIn() &&
                       existing().ownerUid == request.auth.uid &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidOwnerPolicy(incoming(), request.auth.uid) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'wyattEmail', 'allowedEmails', 'lastLoginEmail',
                         'lastLoginDevice', 'lastLoginAt', 'updatedAt'
                       ]);
      allow delete: if false;
    }

    match /users/{userId}/security_events/{eventId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(eventId);
      allow create: if isOwner(userId) && isValidId(eventId) &&
                       incoming().keys().hasAll([
                         'userId', 'eventType', 'severity', 'title', 'detail',
                         'deviceLabel', 'resolved', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'eventType', 'severity', 'title', 'detail',
                         'deviceLabel', 'resolved', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidSecurityEvent(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(eventId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidSecurityEvent(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['resolved', 'updatedAt']);
    }

    match /users/{userId}/improvement_proposals/{proposalId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(proposalId);
      allow create: if isOwner(userId) && isValidId(proposalId) &&
                       incoming().keys().hasAll([
                         'userId', 'title', 'category', 'priority', 'whatToChange', 'why',
                         'impact', 'risks', 'rollbackHowTo', 'preparedPlan', 'weekKey',
                         'status', 'appliedVersionId', 'beforePreview', 'afterPreview',
                         'supports24hTrial', 'trialAccentStyle', 'trialThemeMode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'title', 'category', 'priority', 'whatToChange', 'why',
                         'impact', 'risks', 'rollbackHowTo', 'preparedPlan', 'weekKey',
                         'status', 'appliedVersionId', 'beforePreview', 'afterPreview',
                         'supports24hTrial', 'trialAccentStyle', 'trialThemeMode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidImprovementProposal(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(proposalId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidImprovementProposal(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'status', 'preparedPlan', 'appliedVersionId', 'updatedAt'
                       ]);
    }

    match /users/{userId}/app_versions/{versionId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(versionId);
      allow create: if isOwner(userId) && isValidId(versionId) &&
                       incoming().keys().hasAll([
                         'userId', 'versionTag', 'summary', 'appliedProposalIds',
                         'activeNotes', 'current', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'versionTag', 'summary', 'appliedProposalIds',
                         'activeNotes', 'current', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidAppVersionSnapshot(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(versionId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidAppVersionSnapshot(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['current', 'updatedAt']);
    }

    match /users/{userId}/ui_prefs/{prefId} {
      allow list: if isOwner(userId);
      allow get, delete: if isOwner(userId) && isValidId(prefId);
      allow create: if isOwner(userId) && isValidId(prefId) &&
                       incoming().keys().hasAll([
                         'userId', 'themeMode', 'accentStyle', 'textScale', 'moduleOrder',
                         'hiddenModules', 'enabledGadgets', 'trialLabel', 'trialExpiresAtMs',
                         'previousThemeSnapshot', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'themeMode', 'accentStyle', 'textScale', 'moduleOrder',
                         'hiddenModules', 'enabledGadgets', 'trialLabel', 'trialExpiresAtMs',
                         'previousThemeSnapshot', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidUiPreferences(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(prefId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUiPreferences(incoming(), userId) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'themeMode', 'accentStyle', 'textScale', 'moduleOrder',
                         'hiddenModules', 'enabledGadgets', 'trialLabel', 'trialExpiresAtMs',
                         'previousThemeSnapshot', 'updatedAt'
                       ]);
    }
  }
}
